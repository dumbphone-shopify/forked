    "custom_liquid_qLkEFd": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- Tailwind CSS (CDN) -->\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n  tailwind.config = {\n    theme: {\n      extend: {\n        fontFamily: {\n          sans: ['Inter', 'system-ui', 'sans-serif'],\n        },\n        colors: {\n          brand: {\n            black: '#111111',\n            gray: '#F5F5F5',\n          }\n        }\n      }\n    }\n  }\n</script>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  /* Scoped styles to prevent scrollbar issues in the timeline */\n  .hide-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n  .hide-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n  \n  /* Simple fade animation classes */\n  .fade-in {\n    animation: fadeIn 0.5s ease-in-out;\n  }\n  @keyframes fadeIn {\n    from { opacity: 0; transform: translateY(10px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  /* Helper to hide/show views */\n  .view-section {\n    display: none;\n  }\n  .view-section.active {\n    display: block;\n  }\n  \n  /* Custom overrides for specific form styling to match dumbphone aesthetic */\n  input:focus, textarea:focus {\n    outline: none;\n    border-color: #000;\n    ring: 1px solid #000;\n  }\n</style>\n\n<!-- Root Container - Added mx-auto and max-width to fix alignment -->\n<div id=\"eksperiment-root\" class=\"font-sans text-gray-900 bg-white min-h-[80vh] w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\n\n  <!-- Navigation Header (Hidden on Landing) -->\n  <nav id=\"nav-header\" class=\"bg-white border-b border-gray-100 mb-8 sticky top-0 z-50 hidden\">\n      <div class=\"flex justify-between h-16 items-center\">\n        <button onclick=\"switchView('LANDING')\" class=\"flex items-center text-gray-500 hover:text-black transition-colors font-medium text-sm tracking-wide\">\n          <!-- Icon: ChevronLeft -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"mr-1\"><path d=\"m15 18-6-6 6-6\"/></svg>\n          TILBAGE\n        </button>\n        <span id=\"nav-title\" class=\"text-xs text-gray-400 font-bold tracking-widest uppercase\">\n          <!-- Title populated by JS -->\n        </span>\n      </div>\n  </nav>\n\n  <!-- VIEW: LANDING -->\n  <div id=\"view-landing\" class=\"view-section active py-12 flex flex-col items-center justify-center min-h-[60vh]\">\n    <!-- Intro -->\n    <div class=\"max-w-4xl w-full text-center mb-16 space-y-6\">\n      <h1 class=\"text-4xl md:text-6xl font-extrabold text-black tracking-tight leading-tight\">\n        Vi skaber <span class=\"underline decoration-4 decoration-gray-200\">digitale eksperimenter</span>\n      </h1>\n      <p class=\"text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed font-light\">\n        Foredrag og workshops, der rykker ved vanerne. <br class=\"hidden md:block\" />Til skoler, uddannelser og virksomheder.\n      </p>\n      \n      <!-- Video Placeholder -->\n      <div class=\"max-w-3xl mx-auto mt-10 rounded-xl overflow-hidden shadow-xl border border-gray-200 cursor-pointer group relative h-64 md:h-96 bg-gray-100\" onclick=\"alert('Video ville afspille her')\">\n        <img src=\"https://picsum.photos/800/600\" alt=\"Video thumbnail\" class=\"absolute inset-0 w-full h-full object-cover grayscale opacity-80 group-hover:opacity-60 transition-opacity duration-300\">\n        <div class=\"absolute inset-0 bg-black/10 group-hover:bg-black/20 transition-colors duration-300\"></div>\n        <div class=\"absolute inset-0 flex flex-col items-center justify-center z-10 text-center p-4\">\n          <div class=\"w-20 h-20 bg-black text-white rounded-full flex items-center justify-center mb-4 shadow-lg group-hover:scale-105 transition-transform duration-300\">\n            <!-- Icon: Play -->\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"white\" stroke=\"currentColor\" stroke-width=\"0\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-1\"><polygon points=\"5 3 19 12 5 21 5 3\"/></svg>\n          </div>\n          <h3 class=\"text-white font-bold text-lg drop-shadow-md tracking-wide uppercase\">Se Showreel</h3>\n        </div>\n      </div>\n    </div>\n\n    <!-- Selection Cards -->\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl w-full\">\n      \n      <!-- School Card -->\n      <button onclick=\"switchView('SCHOOL')\" class=\"group relative bg-white p-8 rounded-xl border-2 border-gray-100 hover:border-black transition-all duration-300 text-left flex flex-col h-full w-full\">\n        <div class=\"bg-gray-50 w-14 h-14 rounded-lg flex items-center justify-center mb-6 group-hover:bg-black group-hover:text-white transition-colors text-black\">\n          <!-- Icon: GraduationCap -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 10v6M2 10l10-5 10 5-10 5z\"/><path d=\"M6 12v5c3 3 9 3 12 0v-5\"/></svg>\n        </div>\n        <h2 class=\"text-2xl font-bold text-black mb-2\">Skoler & Uddannelser</h2>\n        <p class=\"text-gray-500 mb-8 flex-grow leading-relaxed\">\n          Foredrag i øjenhøjde til elever og gratis arrangementer for forældre. Fokus på trivsel.\n        </p>\n        <div class=\"flex items-center text-black font-semibold group-hover:underline decoration-2 underline-offset-4\">\n          Vælg Skole \n          <!-- Icon: ArrowRight -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-2 group-hover:translate-x-1 transition-transform\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg>\n        </div>\n      </button>\n\n      <!-- Company Card -->\n      <button onclick=\"switchView('COMPANY')\" class=\"group relative bg-black p-8 rounded-xl border-2 border-black hover:bg-gray-900 transition-all duration-300 text-left flex flex-col h-full w-full\">\n        <div class=\"bg-gray-800 w-14 h-14 rounded-lg flex items-center justify-center mb-6 text-white\">\n          <!-- Icon: Briefcase -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect width=\"20\" height=\"14\" x=\"2\" y=\"7\" rx=\"2\" ry=\"2\"/><path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"/></svg>\n        </div>\n        <h2 class=\"text-2xl font-bold text-white mb-2\">Virksomheder</h2>\n        <p class=\"text-gray-400 mb-8 flex-grow leading-relaxed\">\n          Professionelle workshops. Køb et eksperiment inkl. sparring og \"Dumbphone\" værktøjer.\n        </p>\n        <div class=\"flex items-center text-white font-semibold group-hover:underline decoration-2 underline-offset-4\">\n          Vælg Virksomhed \n          <!-- Icon: ArrowRight -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-2 group-hover:translate-x-1 transition-transform\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg>\n        </div>\n      </button>\n\n    </div>\n  </div>\n\n  <!-- VIEW: SCHOOL -->\n  <div id=\"view-school\" class=\"view-section bg-white\">\n    <!-- Hero / Timeline -->\n    <div class=\"bg-white border-b border-gray-100 pb-16\">\n      <div class=\"max-w-4xl mx-auto text-center\">\n        <h1 class=\"text-3xl md:text-4xl font-extrabold text-black mb-4\">Foredrag til Skoler</h1>\n        <p class=\"text-lg text-gray-500 mb-10 max-w-xl mx-auto\">\n          Vælg klassetrin herunder for at se det relevante forløb.\n        </p>\n        \n        <!-- Timeline Component -->\n        <div class=\"w-full overflow-x-auto pb-4 hide-scrollbar\">\n          <div class=\"flex justify-center min-w-max px-2\">\n            <div class=\"bg-gray-50 rounded-full p-2 border border-gray-200 inline-flex items-center space-x-2\">\n              \n              <!-- Button: Indskoling -->\n              <button onclick=\"setSchoolGrade('INDSKOLING')\" id=\"btn-indskoling\" class=\"flex items-center space-x-3 px-6 py-3 rounded-full transition-all duration-300 bg-black text-white shadow-md\">\n                <div class=\"flex -space-x-1\">\n                  <!-- Grades 0-4 -->\n                  <span class=\"w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold bg-white text-black border border-gray-200 timeline-bubble\">0</span>\n                  <span class=\"w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold bg-white text-black border border-gray-200 timeline-bubble\">1</span>\n                  <span class=\"w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold bg-white text-black border border-gray-200 timeline-bubble\">2</span>\n                  <span class=\"w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold bg-white text-black border border-gray-200 timeline-bubble\">3</span>\n                  <span class=\"w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold bg-white text-black border border-gray-200 timeline-bubble\">4</span>\n                </div>\n                <span class=\"font-bold tracking-tight text-sm\">Indskoling (Forældre)</span>\n              </button>\n\n              <div class=\"h-6 w-px bg-gray-300 mx-2\"></div>\n\n              <!-- Button: Udskoling -->\n              <button onclick=\"setSchoolGrade('UDSKOLING_UNGDOM')\" id=\"btn-udskoling\" class=\"flex items-center space-x-3 px-6 py-3 rounded-full transition-all duration-300 hover:bg-gray-200 text-gray-500\">\n                <span class=\"font-bold tracking-tight text-sm mr-2\">Udskoling & Ungdom</span>\n                <div class=\"flex -space-x-1\">\n                  <!-- Grades 5-10 -->\n                  <span class=\"w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold bg-gray-200 text-gray-500 border border-transparent timeline-bubble\">5</span>\n                  <span class=\"w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold bg-gray-200 text-gray-500 border border-transparent timeline-bubble\">6</span>\n                  <span class=\"w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold bg-gray-200 text-gray-500 border border-transparent timeline-bubble\">...</span>\n                  <span class=\"w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold bg-gray-200 text-gray-500 border border-transparent timeline-bubble\">10</span>\n                </div>\n              </button>\n\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Dynamic Content Area -->\n    <div class=\"max-w-7xl mx-auto pt-12 pb-20\">\n      <div class=\"bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden\">\n        \n        <!-- INDSKOLING CONTENT -->\n        <div id=\"content-indskoling\" class=\"p-8 lg:p-12 fade-in\">\n          <div class=\"flex flex-col lg:flex-row gap-12 items-start\">\n            <div class=\"lg:w-1/2 space-y-6\">\n              <span class=\"inline-block px-3 py-1 bg-black text-white rounded text-xs font-bold tracking-widest uppercase\">\n                Gratis Forældreforedrag\n              </span>\n              <h2 class=\"text-3xl font-bold text-black tracking-tight\">De første digitale skridt</h2>\n              <p class=\"text-lg text-gray-600 leading-relaxed font-light\">\n                Et målrettet foredrag til forældre i 0. - 4. klasse. Vi fokuserer på at skabe gode vaner tidligt, uden løftede pegefingre, men med fælles forståelse.\n              </p>\n              <ul class=\"space-y-4 pt-4\">\n                <li class=\"flex items-start text-gray-800\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-5 h-5 mr-3 text-black mt-1\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg>\n                  <span><strong>Fælles sprog</strong> for forældregruppen</span>\n                </li>\n                <li class=\"flex items-start text-gray-800\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-5 h-5 mr-3 text-black mt-1\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><polyline points=\"16 11 18 13 22 9\"/></svg>\n                  <span><strong>Konkrete råd</strong> til skærmtid og spil</span>\n                </li>\n              </ul>\n              \n              <div class=\"pt-8\">\n                <button onclick=\"shareLink()\" class=\"inline-flex items-center px-6 py-3 border-2 border-black text-sm font-bold uppercase tracking-wide rounded text-black bg-transparent hover:bg-black hover:text-white transition-colors\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"mr-2\"><circle cx=\"18\" cy=\"5\" r=\"3\"/><circle cx=\"6\" cy=\"12\" r=\"3\"/><circle cx=\"18\" cy=\"19\" r=\"3\"/><line x1=\"8.59\" x2=\"15.42\" y1=\"13.51\" y2=\"17.49\"/><line x1=\"15.41\" x2=\"8.59\" y1=\"6.51\" y2=\"10.49\"/></svg>\n                  Kopier link til ledelsen\n                </button>\n              </div>\n            </div>\n            <div class=\"lg:w-1/2 w-full\">\n              <div class=\"relative w-full h-64 lg:h-96 bg-gray-100 rounded-lg flex items-center justify-center group cursor-pointer overflow-hidden border border-gray-200\" onclick=\"alert('Video ville afspille her')\">\n                 <img src=\"https://picsum.photos/800/601\" alt=\"Video thumbnail\" class=\"absolute inset-0 w-full h-full object-cover grayscale opacity-80 group-hover:opacity-60 transition-opacity duration-300\">\n                 <div class=\"relative z-10 text-center p-4\">\n                   <div class=\"w-16 h-16 bg-black text-white rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300\">\n                     <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"white\" stroke=\"currentColor\" stroke-width=\"0\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-1\"><polygon points=\"5 3 19 12 5 21 5 3\"/></svg>\n                   </div>\n                   <h3 class=\"text-white font-bold text-lg uppercase tracking-wider\">Se Video</h3>\n                 </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- UDSKOLING CONTENT (Hidden by default) -->\n        <div id=\"content-udskoling\" class=\"p-8 lg:p-12 fade-in\" style=\"display: none;\">\n          <div class=\"flex flex-col lg:flex-row gap-12 items-start\">\n            <div class=\"lg:w-1/2 space-y-6\">\n                <span class=\"inline-block px-3 py-1 bg-black text-white rounded text-xs font-bold tracking-widest uppercase\">\n                Elevforedrag + Eksperiment\n              </span>\n              <h2 class=\"text-3xl font-bold text-black tracking-tight\">Oprør mod algoritmene</h2>\n              <p class=\"text-lg text-gray-600 leading-relaxed font-light\">\n                For 5. - 10. klasse samt ungdomsuddannelser. Vi taler direkte til de unge i øjenhøjde. Foredraget lægger op til et fælles eksperiment med skærmforbrug.\n              </p>\n              \n              <div class=\"bg-gray-50 p-6 rounded border border-gray-200\">\n                <h3 class=\"font-bold text-black mb-3 uppercase text-sm tracking-wide\">Pakken inkluderer:</h3>\n                <ul class=\"space-y-2 text-gray-700\">\n                  <li class=\"flex items-center\"><span class=\"w-1.5 h-1.5 bg-black rounded-full mr-2\"></span> 1 times sparring med ledelse/lærere</li>\n                  <li class=\"flex items-center\"><span class=\"w-1.5 h-1.5 bg-black rounded-full mr-2\"></span> Interaktivt foredrag for eleverne</li>\n                  <li class=\"flex items-center\"><span class=\"w-1.5 h-1.5 bg-black rounded-full mr-2\"></span> Materiale til 10-dages eksperiment</li>\n                </ul>\n              </div>\n\n              <div class=\"pt-8\">\n                <button onclick=\"shareLink()\" class=\"inline-flex items-center px-6 py-3 border-2 border-black text-sm font-bold uppercase tracking-wide rounded text-black bg-transparent hover:bg-black hover:text-white transition-colors\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"mr-2\"><circle cx=\"18\" cy=\"5\" r=\"3\"/><circle cx=\"6\" cy=\"12\" r=\"3\"/><circle cx=\"18\" cy=\"19\" r=\"3\"/><line x1=\"8.59\" x2=\"15.42\" y1=\"13.51\" y2=\"17.49\"/><line x1=\"15.41\" x2=\"8.59\" y1=\"6.51\" y2=\"10.49\"/></svg>\n                  Kopier link til ledelsen\n                </button>\n              </div>\n            </div>\n            <div class=\"lg:w-1/2 w-full\">\n               <div class=\"relative w-full h-64 lg:h-96 bg-gray-100 rounded-lg flex items-center justify-center group cursor-pointer overflow-hidden border border-gray-200\" onclick=\"alert('Video ville afspille her')\">\n                 <img src=\"https://picsum.photos/800/602\" alt=\"Video thumbnail\" class=\"absolute inset-0 w-full h-full object-cover grayscale opacity-80 group-hover:opacity-60 transition-opacity duration-300\">\n                 <div class=\"relative z-10 text-center p-4\">\n                   <div class=\"w-16 h-16 bg-black text-white rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300\">\n                     <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"white\" stroke=\"currentColor\" stroke-width=\"0\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-1\"><polygon points=\"5 3 19 12 5 21 5 3\"/></svg>\n                   </div>\n                   <h3 class=\"text-white font-bold text-lg uppercase tracking-wider\">Se Video</h3>\n                 </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n    <!-- Testimonials -->\n    <div class=\"max-w-7xl mx-auto py-16\">\n      <h3 class=\"text-2xl font-bold text-center mb-12 uppercase tracking-widest text-gray-400\">Det siger skolerne</h3>\n      <div class=\"grid md:grid-cols-3 gap-8\">\n           <!-- Card 1 -->\n           <div class=\"bg-gray-50 p-8 rounded-xl border border-gray-100\">\n             <div class=\"text-4xl text-gray-300 mb-4 font-serif\">\"</div>\n             <p class=\"text-gray-800 mb-6 italic leading-relaxed\">Eleverne var tryllebundet fra start til slut. Det var ikke en løftet pegefinger, men en invitation til at tænke selv.</p>\n             <div class=\"font-bold text-black text-sm uppercase tracking-wide\">- Lærer, 8. årgang</div>\n           </div>\n           <!-- Card 2 -->\n           <div class=\"bg-gray-50 p-8 rounded-xl border border-gray-100\">\n             <div class=\"text-4xl text-gray-300 mb-4 font-serif\">\"</div>\n             <p class=\"text-gray-800 mb-6 italic leading-relaxed\">Endelig noget om digital dannelse, som vi faktisk kunne bruge konkret i undervisningen ugen efter.</p>\n             <div class=\"font-bold text-black text-sm uppercase tracking-wide\">- Skoleleder</div>\n           </div>\n           <!-- Card 3 -->\n           <div class=\"bg-gray-50 p-8 rounded-xl border border-gray-100\">\n             <div class=\"text-4xl text-gray-300 mb-4 font-serif\">\"</div>\n             <p class=\"text-gray-800 mb-6 italic leading-relaxed\">Forældrene gik derfra med en helt ny forståelse for deres børns digitale liv.</p>\n             <div class=\"font-bold text-black text-sm uppercase tracking-wide\">- Bestyrelsesformand</div>\n           </div>\n      </div>\n    </div>\n\n    <!-- Contact Form School -->\n    <div class=\"bg-white border-t border-gray-100 py-16\">\n      <div class=\"max-w-2xl mx-auto\">\n        <div class=\"bg-white p-8 md:p-12 rounded-2xl shadow-xl border border-gray-100\">\n            <div class=\"text-center mb-8\">\n              <h3 class=\"text-2xl font-bold text-black\">Kontakt os for pris</h3>\n              <p class=\"text-gray-500 mt-2\">Udfyld formularen, så vender vi tilbage indenfor 24 timer.</p>\n            </div>\n            \n            <form onsubmit=\"handleContactSubmit(event, 'school-subject-input')\" class=\"space-y-5\">\n              <div>\n                <label class=\"block text-xs font-bold text-gray-500 uppercase tracking-wide mb-2\">Din e-mail</label>\n                <input type=\"email\" required class=\"w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded text-black placeholder-gray-400 focus:bg-white transition-colors\" placeholder=\"navn@skole.dk\">\n              </div>\n              <div>\n                <label class=\"block text-xs font-bold text-gray-500 uppercase tracking-wide mb-2\">Emne</label>\n                <input id=\"school-subject-input\" type=\"text\" disabled class=\"w-full px-4 py-3 bg-gray-100 border border-gray-200 rounded text-gray-600 font-medium\" value=\"Forespørgsel: Indskoling\">\n              </div>\n              <div>\n                <label class=\"block text-xs font-bold text-gray-500 uppercase tracking-wide mb-2\">Besked (Valgfri)</label>\n                <textarea rows=\"4\" class=\"w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded text-black placeholder-gray-400 focus:bg-white transition-colors\" placeholder=\"Skriv eventuelt datoønsker eller særlige behov...\"></textarea>\n              </div>\n              <button type=\"submit\" class=\"w-full flex items-center justify-center px-8 py-4 bg-black text-white font-bold uppercase tracking-widest rounded hover:bg-gray-800 transition-colors\">\n                Send forespørgsel \n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-2\"><path d=\"m22 2-7 20-4-9-9-4Z\"/><path d=\"M22 2 11 13\"/></svg>\n              </button>\n            </form>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- VIEW: COMPANY -->\n  <div id=\"view-company\" class=\"view-section bg-white min-h-screen\">\n      <!-- Hero Section -->\n      <div class=\"bg-black text-white pt-20 pb-24 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 mb-12\">\n        <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-16\">\n          <div class=\"md:w-1/2 space-y-8\">\n            <div class=\"inline-flex items-center px-3 py-1 rounded border border-white/20 text-white text-xs font-bold tracking-widest uppercase\">\n              Corporate Workshop & Keynote\n            </div>\n            <h1 class=\"text-4xl md:text-5xl font-bold leading-tight tracking-tight\">\n              Køb et eksperiment,<br/> ikke bare et foredrag.\n            </h1>\n            <p class=\"text-xl text-gray-400 max-w-lg font-light leading-relaxed\">\n              En workshop-pakke, der ændrer virksomhedskulturen omkring digital tilgængelighed og fokus.\n            </p>\n            <div class=\"flex flex-wrap gap-4 pt-4\">\n               <button onclick=\"document.getElementById('company-contact').scrollIntoView({ behavior: 'smooth' })\" class=\"px-8 py-3 bg-white text-black font-bold rounded hover:bg-gray-200 transition-colors\">\n                  Få et tilbud\n                </button>\n                <button onclick=\"shareLink()\" class=\"px-8 py-3 bg-transparent border border-gray-600 hover:border-white text-white font-bold rounded transition-colors flex items-center\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"mr-2\"><circle cx=\"18\" cy=\"5\" r=\"3\"/><circle cx=\"6\" cy=\"12\" r=\"3\"/><circle cx=\"18\" cy=\"19\" r=\"3\"/><line x1=\"8.59\" x2=\"15.42\" y1=\"13.51\" y2=\"17.49\"/><line x1=\"15.41\" x2=\"8.59\" y1=\"6.51\" y2=\"10.49\"/></svg>\n                  Del med chefen\n                </button>\n            </div>\n          </div>\n          <div class=\"md:w-1/2 w-full\">\n            <div class=\"rounded overflow-hidden border border-gray-800 shadow-2xl relative h-64 md:h-80 bg-gray-900 group cursor-pointer\" onclick=\"alert('Video ville afspille her')\">\n                <img src=\"https://picsum.photos/800/603\" alt=\"Video thumbnail\" class=\"absolute inset-0 w-full h-full object-cover grayscale opacity-60 group-hover:opacity-40 transition-opacity duration-300\">\n                <div class=\"absolute inset-0 flex flex-col items-center justify-center z-10 text-center p-4\">\n                  <div class=\"w-16 h-16 bg-white/10 backdrop-blur rounded-full flex items-center justify-center mx-auto mb-4 border border-white/20 group-hover:scale-110 transition-transform duration-300\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"white\" stroke=\"currentColor\" stroke-width=\"0\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-1\"><polygon points=\"5 3 19 12 5 21 5 3\"/></svg>\n                  </div>\n                  <h3 class=\"text-white font-bold text-lg uppercase tracking-wider\">Hvad får virksomheden ud af det?</h3>\n                </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- The Package Breakdown -->\n      <div class=\"max-w-7xl mx-auto mb-20\">\n        <div class=\"text-center mb-16\">\n          <h2 class=\"text-3xl font-bold text-black tracking-tight\">En komplet pakke</h2>\n          <p class=\"text-gray-500 mt-2 font-light text-lg\">Vi leverer tre konkrete elementer i forløbet</p>\n        </div>\n\n        <div class=\"grid md:grid-cols-3 gap-8\">\n          <!-- Step 1 -->\n          <div class=\"bg-gray-50 p-8 rounded-xl border border-gray-100 hover:border-black transition-colors group\">\n            <div class=\"w-12 h-12 bg-white border border-gray-200 rounded flex items-center justify-center mb-6 text-black group-hover:bg-black group-hover:text-white transition-colors\">\n              <span class=\"font-bold text-xl\">1</span>\n            </div>\n            <h3 class=\"text-xl font-bold text-black mb-3\">Sparring</h3>\n            <p class=\"text-gray-600 leading-relaxed font-light\">\n              1 times online introducerende møde med ledelsen. Vi afdækker jeres behov og designer det eksperiment, I ønsker at lægge op til.\n            </p>\n          </div>\n\n          <!-- Step 2 -->\n          <div class=\"bg-gray-50 p-8 rounded-xl border border-gray-100 hover:border-black transition-colors group\">\n            <div class=\"w-12 h-12 bg-white border border-gray-200 rounded flex items-center justify-center mb-6 text-black group-hover:bg-black group-hover:text-white transition-colors\">\n              <span class=\"font-bold text-xl\">2</span>\n            </div>\n            <h3 class=\"text-xl font-bold text-black mb-3\">Workshop</h3>\n            <p class=\"text-gray-600 leading-relaxed font-light\">\n              En engagerende, sjov og tankevækkende session for alle medarbejdere. Vi kombinerer viden med interaktive øvelser.\n            </p>\n          </div>\n\n          <!-- Step 3 -->\n          <div class=\"bg-gray-50 p-8 rounded-xl border border-gray-100 hover:border-black transition-colors group\">\n             <div class=\"w-12 h-12 bg-white border border-gray-200 rounded flex items-center justify-center mb-6 text-black group-hover:bg-black group-hover:text-white transition-colors\">\n              <span class=\"font-bold text-xl\">3</span>\n            </div>\n            <h3 class=\"text-xl font-bold text-black mb-3\">Værktøjer</h3>\n            <p class=\"text-gray-600 leading-relaxed font-light\">\n              Lån af fysiske \"Dumbphone\" effekter i 10 dage: Smartphone låsesleeves og gammeldags vækkeure til alle deltagere.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Why Choose Us -->\n      <div class=\"py-16 border-t border-gray-100 bg-gray-50 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8\">\n        <div class=\"max-w-4xl mx-auto\">\n          <h2 class=\"text-2xl font-bold text-center text-black mb-12 uppercase tracking-wide\">Hvorfor vælge dette format?</h2>\n          <div class=\"grid md:grid-cols-2 gap-6\">\n              <div class=\"flex items-start bg-white p-4 rounded border border-gray-200\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-6 h-6 text-black mr-4 flex-shrink-0 mt-0.5\"><path d=\"M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n                <span class=\"text-gray-800 font-medium\">Det er mere end bare 'lyt og glem' - det er handling.</span>\n              </div>\n              <div class=\"flex items-start bg-white p-4 rounded border border-gray-200\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-6 h-6 text-black mr-4 flex-shrink-0 mt-0.5\"><path d=\"M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n                <span class=\"text-gray-800 font-medium\">Vi adresserer digital stress på en kollektiv måde.</span>\n              </div>\n              <div class=\"flex items-start bg-white p-4 rounded border border-gray-200\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-6 h-6 text-black mr-4 flex-shrink-0 mt-0.5\"><path d=\"M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n                <span class=\"text-gray-800 font-medium\">Det skaber en fælles referenceramme på kontoret.</span>\n              </div>\n              <div class=\"flex items-start bg-white p-4 rounded border border-gray-200\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-6 h-6 text-black mr-4 flex-shrink-0 mt-0.5\"><path d=\"M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n                <span class=\"text-gray-800 font-medium\">Professionelt setup, men med plads til humor.</span>\n              </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Contact -->\n      <div id=\"company-contact\" class=\"bg-white py-16\">\n        <div class=\"max-w-2xl mx-auto\">\n            <div class=\"bg-white p-8 md:p-12 rounded-2xl shadow-xl border border-gray-100\">\n                <div class=\"text-center mb-8\">\n                  <h3 class=\"text-2xl font-bold text-black\">Få et uforpligtende tilbud</h3>\n                  <p class=\"text-gray-500 mt-2\">Vi skræddersyr forløbet til jeres virksomhed.</p>\n                </div>\n                \n                <form onsubmit=\"handleContactSubmit(event, 'company-subject-input')\" class=\"space-y-5\">\n                  <div>\n                    <label class=\"block text-xs font-bold text-gray-500 uppercase tracking-wide mb-2\">Din e-mail</label>\n                    <input type=\"email\" required class=\"w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded text-black placeholder-gray-400 focus:bg-white transition-colors\" placeholder=\"navn@virksomhed.dk\">\n                  </div>\n                  <div>\n                    <label class=\"block text-xs font-bold text-gray-500 uppercase tracking-wide mb-2\">Emne</label>\n                    <input id=\"company-subject-input\" type=\"text\" disabled class=\"w-full px-4 py-3 bg-gray-100 border border-gray-200 rounded text-gray-600 font-medium\" value=\"Forespørgsel: Virksomhedsworkshop\">\n                  </div>\n                  <div>\n                    <label class=\"block text-xs font-bold text-gray-500 uppercase tracking-wide mb-2\">Besked (Valgfri)</label>\n                    <textarea rows=\"4\" class=\"w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded text-black placeholder-gray-400 focus:bg-white transition-colors\" placeholder=\"Skriv eventuelt datoønsker eller særlige behov...\"></textarea>\n                  </div>\n                  <button type=\"submit\" class=\"w-full flex items-center justify-center px-8 py-4 bg-black text-white font-bold uppercase tracking-widest rounded hover:bg-gray-800 transition-colors\">\n                    Send forespørgsel \n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-2\"><path d=\"m22 2-7 20-4-9-9-4Z\"/><path d=\"M22 2 11 13\"/></svg>\n                  </button>\n                </form>\n            </div>\n        </div>\n      </div>\n  </div>\n\n  <!-- Footer -->\n  <footer class=\"bg-gray-50 border-t border-gray-200 py-12\">\n    <div class=\"max-w-7xl mx-auto px-4 text-center\">\n      <p class=\"text-gray-400 text-sm\">© 2024 Eksperiment Ekspert / Dumbphone.dk. Alle rettigheder forbeholdes.</p>\n    </div>\n  </footer>\n\n</div>\n\n<!-- APPLICATION LOGIC -->\n<script>\n  // State variables\n  let currentView = 'LANDING'; // 'LANDING', 'SCHOOL', 'COMPANY'\n  let currentSchoolGroup = 'INDSKOLING'; // 'INDSKOLING', 'UDSKOLING_UNGDOM'\n\n  // DOM Elements\n  const navHeader = document.getElementById('nav-header');\n  const navTitle = document.getElementById('nav-title');\n  const viewLanding = document.getElementById('view-landing');\n  const viewSchool = document.getElementById('view-school');\n  const viewCompany = document.getElementById('view-company');\n  const rootElement = document.getElementById('eksperiment-root');\n\n  // School Specific DOM\n  const btnIndskoling = document.getElementById('btn-indskoling');\n  const btnUdskoling = document.getElementById('btn-udskoling');\n  const contentIndskoling = document.getElementById('content-indskoling');\n  const contentUdskoling = document.getElementById('content-udskoling');\n  const schoolSubjectInput = document.getElementById('school-subject-input');\n\n  // Logic: Switch Views\n  function switchView(viewName) {\n    currentView = viewName;\n    \n    // Hide all views first\n    viewLanding.classList.remove('active');\n    viewSchool.classList.remove('active');\n    viewCompany.classList.remove('active');\n    \n    // Toggle Nav Header\n    if (viewName === 'LANDING') {\n      navHeader.classList.add('hidden');\n      rootElement.scrollIntoView({ behavior: 'smooth' });\n    } else {\n      navHeader.classList.remove('hidden');\n      window.scrollTo({ top: rootElement.offsetTop - 50, behavior: 'smooth' });\n    }\n\n    // Show selected view\n    if (viewName === 'LANDING') {\n      viewLanding.classList.add('active');\n    } else if (viewName === 'SCHOOL') {\n      viewSchool.classList.add('active');\n      navTitle.textContent = 'Skoler & Uddannelser';\n    } else if (viewName === 'COMPANY') {\n      viewCompany.classList.add('active');\n      navTitle.textContent = 'Virksomheder';\n    }\n  }\n\n  // Logic: Switch School Grades\n  function setSchoolGrade(group) {\n    currentSchoolGroup = group;\n    \n    // Styling classes for Active/Inactive buttons\n    // Dumbphone style: Black/White toggle\n    const activeClasses = ['bg-black', 'text-white', 'shadow-md'];\n    const inactiveClasses = ['hover:bg-gray-200', 'text-gray-500'];\n\n    // Bubbles inside buttons (visual tweak)\n    const indskolingBubbles = btnIndskoling.querySelectorAll('.timeline-bubble');\n    const udskolingBubbles = btnUdskoling.querySelectorAll('.timeline-bubble');\n\n    if (group === 'INDSKOLING') {\n        // Activate Indskoling Button\n        btnIndskoling.classList.add(...activeClasses);\n        btnIndskoling.classList.remove(...inactiveClasses);\n        \n        // Deactivate Udskoling Button\n        btnUdskoling.classList.remove(...activeClasses);\n        btnUdskoling.classList.add(...inactiveClasses);\n\n        // Update Bubble Colors\n        indskolingBubbles.forEach(b => { \n            b.classList.remove('bg-gray-200', 'text-gray-500', 'border-transparent'); \n            b.classList.add('bg-white', 'text-black', 'border-gray-200'); \n        });\n        udskolingBubbles.forEach(b => { \n            b.classList.remove('bg-white', 'text-black', 'border-gray-200'); \n            b.classList.add('bg-gray-200', 'text-gray-500', 'border-transparent'); \n        });\n\n        // Switch Content\n        contentIndskoling.style.display = 'block';\n        contentUdskoling.style.display = 'none';\n\n        // Update Form Subject\n        if(schoolSubjectInput) schoolSubjectInput.value = \"Forespørgsel: Indskoling\";\n\n    } else {\n        // Activate Udskoling Button\n        btnUdskoling.classList.add(...activeClasses);\n        btnUdskoling.classList.remove(...inactiveClasses);\n        \n        // Deactivate Indskoling Button\n        btnIndskoling.classList.remove(...activeClasses);\n        btnIndskoling.classList.add(...inactiveClasses);\n\n        // Update Bubble Colors\n        udskolingBubbles.forEach(b => { \n            b.classList.remove('bg-gray-200', 'text-gray-500', 'border-transparent'); \n            b.classList.add('bg-white', 'text-black', 'border-gray-200'); \n        });\n        indskolingBubbles.forEach(b => { \n            b.classList.remove('bg-white', 'text-black', 'border-gray-200'); \n            b.classList.add('bg-gray-200', 'text-gray-500', 'border-transparent'); \n        });\n\n        // Switch Content\n        contentIndskoling.style.display = 'none';\n        contentUdskoling.style.display = 'block';\n\n        // Update Form Subject\n        if(schoolSubjectInput) schoolSubjectInput.value = \"Forespørgsel: Udskoling/Ungdom\";\n    }\n  }\n\n  // Logic: Share Link\n  async function shareLink() {\n    try {\n      await navigator.clipboard.writeText(window.location.href);\n      alert('Link kopieret til udklipsholderen!');\n    } catch (err) {\n      console.error('Failed to copy', err);\n      alert('Kunne ikke kopiere linket automatisk. Kopier venligst URLen fra browseren.');\n    }\n  }\n\n  // Logic: Form Submit\n  function handleContactSubmit(e, subjectInputId) {\n    e.preventDefault();\n    const subject = document.getElementById(subjectInputId).value;\n    alert(`Tak! Vi har modtaget din forespørgsel vedrørende \"${subject}\". Vi vender tilbage snarest.`);\n    e.target.reset();\n  }\n\n  // Initial Setup\n  // Ensure default state matches\n  setSchoolGrade('INDSKOLING');",
