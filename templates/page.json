      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- \n  INSTRUKTIONER TIL SHOPIFY:\n  1. Opret en ny 'Sektion' eller 'Custom Liquid' blok.\n  2. Indsæt hele koden herunder.\n  3. Tryk Gem.\n-->\n\n<!-- Tailwind CSS (CDN) -->\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n  tailwind.config = {\n    theme: {\n      extend: {\n        fontFamily: {\n          sans: ['Inter', 'sans-serif'],\n        },\n      }\n    }\n  }\n</script>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  /* Scoped styles to prevent scrollbar issues in the timeline */\n  .hide-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n  .hide-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n  \n  /* Simple fade animation classes */\n  .fade-in {\n    animation: fadeIn 0.5s ease-in-out;\n  }\n  @keyframes fadeIn {\n    from { opacity: 0; transform: translateY(10px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  /* Helper to hide/show views */\n  .view-section {\n    display: none;\n  }\n  .view-section.active {\n    display: block;\n  }\n</style>\n\n<!-- Root Container -->\n<div id=\"eksperiment-root\" class=\"font-sans text-gray-900 bg-gray-50 min-h-[80vh] w-full\">\n\n  <!-- Navigation Header (Hidden on Landing) -->\n  <nav id=\"nav-header\" class=\"bg-white border-b border-gray-200 sticky top-0 z-50 hidden\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n      <div class=\"flex justify-between h-16 items-center\">\n        <button onclick=\"switchView('LANDING')\" class=\"flex items-center text-gray-600 hover:text-gray-900 transition-colors font-medium\">\n          <!-- Icon: ChevronLeft -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"mr-1\"><path d=\"m15 18-6-6 6-6\"/></svg>\n          Tilbage til oversigt\n        </button>\n        <span id=\"nav-title\" class=\"text-sm text-gray-400 font-medium tracking-wider uppercase\">\n          <!-- Title populated by JS -->\n        </span>\n      </div>\n    </div>\n  </nav>\n\n  <!-- VIEW: LANDING -->\n  <div id=\"view-landing\" class=\"view-section active py-12 px-4 sm:px-6 lg:px-8 flex flex-col items-center justify-center min-h-[80vh]\">\n    <!-- Intro -->\n    <div class=\"max-w-4xl w-full text-center mb-16 space-y-6\">\n      <h1 class=\"text-4xl md:text-6xl font-extrabold text-gray-900 tracking-tight\">\n        Vi skaber <span class=\"text-indigo-600\">digitale eksperimenter</span>\n      </h1>\n      <p class=\"text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed\">\n        Oplev foredrag og workshops, der rykker ved vanerne. Hvad enten det er i klasselokalet eller mødelokalet, skaber vi rum for refleksion og handling.\n      </p>\n      \n      <!-- Video Placeholder -->\n      <div class=\"max-w-3xl mx-auto mt-8 rounded-2xl overflow-hidden shadow-2xl border-4 border-white cursor-pointer group relative h-64 md:h-96 bg-gray-900\" onclick=\"alert('Video ville afspille her')\">\n        <img src=\"https://picsum.photos/800/600\" alt=\"Video thumbnail\" class=\"absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-40 transition-opacity duration-300\">\n        <div class=\"absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors duration-300\"></div>\n        <div class=\"absolute inset-0 flex flex-col items-center justify-center z-10 text-center p-4\">\n          <div class=\"w-16 h-16 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center mb-4 border border-white/50 group-hover:scale-110 transition-transform duration-300\">\n            <!-- Icon: Play -->\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"white\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-1 text-white\"><polygon points=\"5 3 19 12 5 21 5 3\"/></svg>\n          </div>\n          <h3 class=\"text-white font-bold text-lg drop-shadow-md\">Showreel: Eksperimenter i praksis</h3>\n        </div>\n      </div>\n    </div>\n\n    <!-- Selection Cards -->\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl w-full\">\n      \n      <!-- School Card -->\n      <button onclick=\"switchView('SCHOOL')\" class=\"group relative bg-white p-8 rounded-3xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1 text-left border border-gray-100 flex flex-col h-full w-full\">\n        <div class=\"bg-blue-50 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-blue-100 transition-colors\">\n          <!-- Icon: GraduationCap -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 10v6M2 10l10-5 10 5-10 5z\"/><path d=\"M6 12v5c3 3 9 3 12 0v-5\"/></svg>\n        </div>\n        <h2 class=\"text-2xl font-bold text-gray-900 mb-4\">Skoler & Uddannelser</h2>\n        <p class=\"text-gray-600 mb-8 flex-grow\">\n          Foredrag til elever i øjenhøjde og gratis arrangementer for forældre i indskolingen. Fokus på trivsel og digitale vaner.\n        </p>\n        <div class=\"flex items-center text-blue-600 font-semibold group-hover:translate-x-2 transition-transform\">\n          Vælg Skole \n          <!-- Icon: ArrowRight -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-2\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg>\n        </div>\n      </button>\n\n      <!-- Company Card -->\n      <button onclick=\"switchView('COMPANY')\" class=\"group relative bg-slate-900 p-8 rounded-3xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1 text-left border border-slate-700 flex flex-col h-full w-full\">\n        <div class=\"bg-slate-800 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-slate-700 transition-colors\">\n          <!-- Icon: Briefcase -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#818cf8\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect width=\"20\" height=\"14\" x=\"2\" y=\"7\" rx=\"2\" ry=\"2\"/><path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"/></svg>\n        </div>\n        <h2 class=\"text-2xl font-bold text-white mb-4\">Virksomheder</h2>\n        <p class=\"text-slate-300 mb-8 flex-grow\">\n          Professionelle workshops og keynotes. Køb et eksperiment, der inkluderer sparring, værktøjer og konkrete tiltag for medarbejderne.\n        </p>\n        <div class=\"flex items-center text-indigo-400 font-semibold group-hover:translate-x-2 transition-transform\">\n          Vælg Virksomhed \n          <!-- Icon: ArrowRight -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-2\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg>\n        </div>\n      </button>\n\n    </div>\n  </div>\n\n  <!-- VIEW: SCHOOL -->\n  <div id=\"view-school\" class=\"view-section bg-white\">\n    <!-- Hero / Timeline -->\n    <div class=\"bg-blue-50 pt-16 pb-24 px-4 sm:px-6 lg:px-8\">\n      <div class=\"max-w-7xl mx-auto text-center\">\n        <h1 class=\"text-4xl font-extrabold text-gray-900 mb-4\">Foredrag til Skoler</h1>\n        <p class=\"text-xl text-gray-600 mb-12 max-w-2xl mx-auto\">\n          Vælg klassetrin for at se det relevante forløb