        <div class=\"flex space-x-1\">\n                  <!-- Grades 5-10 -->\n                  <span class=\"w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-gray-200 timeline-bubble\">5</span>\n                  <span class=\"w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-gray-200 timeline-bubble\">6</span>\n                  <span class=\"w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-gray-200 timeline-bubble\">8</span>\n                  <span class=\"w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-gray-200 timeline-bubble\">9</span>\n                  <span class=\"w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-gray-200 timeline-bubble\">10</span>\n                  <span class=\"h-8 px-2 rounded-full flex items-center justify-center text-xs font-bold bg-gray-200 timeline-bubble\">Ungdom</span>\n                </div>\n              </button>\n\n            </div>\n          </div>\n          <p class=\"text-center text-sm text-gray-400 mt-4\">Klik på en gruppe for at se detaljer</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Dynamic Content Area -->\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-12 relative z-10 pb-20\">\n      <div class=\"bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100\">\n        \n        <!-- INDSKOLING CONTENT -->\n        <div id=\"content-indskoling\" class=\"p-8 lg:p-12 fade-in\">\n          <div class=\"flex flex-col lg:flex-row gap-12\">\n            <div class=\"lg:w-1/2 space-y-6\">\n              <span class=\"inline-block px-4 py-1.5 bg-green-100 text-green-800 rounded-full text-sm font-bold tracking-wide uppercase\">\n                Gratis\n              </span>\n              <h2 class=\"text-3xl font-bold text-gray-900\">Forældreforedrag: De første digitale skridt</h2>\n              <p class=\"text-lg text-gray-600 leading-relaxed\">\n                Et målrettet foredrag til forældre i 0. - 4. klasse. Vi fokuserer på at skabe gode vaner tidligt, uden løftede pegefingre.\n              </p>\n              <ul class=\"space-y-3\">\n                <li class=\"flex items-center text-gray-700\">\n                  <!-- Icon: Users -->\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-5 h-5 mr-3 text-blue-500\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg>\n                  Fælles sprog for forældregruppen\n                </li>\n                <li class=\"flex items-center text-gray-700\">\n                  <!-- Icon: UserCheck -->\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-5 h-5 mr-3 text-blue-500\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><polyline points=\"16 11 18 13 22 9\"/></svg>\n                  Konkrete råd til skærmtid og spil\n                </li>\n              </ul>\n              \n              <div class=\"pt-6\">\n                <button onclick=\"shareLink()\" class=\"inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-blue-700 bg-blue-100 hover:bg-blue-200 transition-colors\">\n                  <!-- Icon: Share2 -->\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-5 h-5 mr-2\"><circle cx=\"18\" cy=\"5\" r=\"3\"/><circle cx=\"6\" cy=\"12\" r=\"3\"/><circle cx=\"18\" cy=\"19\" r=\"3\"/><line x1=\"8.59\" x2=\"15.42\" y1=\"13.51\" y2=\"17.49\"/><line x1=\"15.41\" x2=\"8.59\" y1=\"6.51\" y2=\"10.49\"/></svg>\n                  Kopier link til ledelsen\n                </button>\n              </div>\n            </div>\n            <div class=\"lg:w-1/2\">\n              <div class=\"relative w-full h-64 lg:h-full bg-gray-900 flex items-center justify-center group cursor-pointer overflow-hidden\" onclick=\"alert('Video ville afspille her')\">\n                 <img src=\"https://picsum.photos/800/601\" alt=\"Video thumbnail\" class=\"absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-40 transition-opacity duration-300\">\n                 <div class=\"absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors duration-300\"></div>\n                 <div class=\"relative z-10 text-center p-4\">\n                   <div class=\"w-16 h-16 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center mx-auto mb-4 border border-white/50 group-hover:scale-110 transition-transform duration-300\">\n                     <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"white\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-1 text-white\"><polygon points=\"5 3 19 12 5 21 5 3\"/></svg>\n                   </div>\n                   <h3 class=\"text-white font-bold text-lg drop-shadow-md\">Video: Intro til Indskolingsforedrag</h3>\n                 </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- UDSKOLING CONTENT (Hidden by default) -->\n        <div id=\"content-udskoling\" class=\"p-8 lg:p-12 fade-in\" style=\"display: none;\">\n          <div class=\"flex flex-col lg:flex-row gap-12\">\n            <div class=\"lg:w-1/2 space-y-6\">\n                <span class=\"inline-block px-4 py-1.5 bg-blue-100 text-blue-800 rounded-full text-sm font-bold tracking-wide uppercase\">\n                Elevforedrag + Eksperiment\n              </span>\n              <h2 class=\"text-3xl font-bold text-gray-900\">Oprør mod algoritmene</h2>\n              <p class=\"text-lg text-gray-600 leading-relaxed\">\n                For 5. - 10. klasse samt ungdomsuddannelser. Vi taler direkte til de unge i øjenhøjde. Foredraget lægger op til et fælles eksperiment med skærmforbrug.\n              </p>\n              \n              <div class=\"bg-gray-50 p-6 rounded-xl border border-gray-100\">\n                <h3 class=\"font-semibold text-gray-900 mb-2\">Pakken inkluderer:</h3>\n                <ul class=\"space-y-2 text-gray-600\">\n                  <li>• 1 times sparring med ledelse/lærere</li>\n                  <li>• Interaktivt foredrag for eleverne</li>\n                  <li>• Materiale til 10-dages eksperiment</li>\n                </ul>\n              </div>\n\n              <div class=\"pt-6\">\n                <button onclick=\"shareLink()\" class=\"inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-blue-700 bg-blue-100 hover:bg-blue-200 transition-colors\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-5 h-5 mr-2\"><circle cx=\"18\" cy=\"5\" r=\"3\"/><circle cx=\"6\" cy=\"12\" r=\"3\"/><circle cx=\"18\" cy=\"19\" r=\"3\"/><line x1=\"8.59\" x2=\"15.42\" y1=\"13.51\" y2=\"17.49\"/><line x1=\"15.41\" x2=\"8.59\" y1=\"6.51\" y2=\"10.49\"/></svg>\n                  Kopier link til ledelsen\n                </button>\n              </div>\n            </div>\n            <div class=\"lg:w-1/2\">\n               <div class=\"relative w-full h-64 lg:h-full bg-gray-900 flex items-center justify-center group cursor-pointer overflow-hidden\" onclick=\"alert('Video ville afspille her')\">\n                 <img src=\"https://picsum.photos/800/602\" alt=\"Video thumbnail\" class=\"absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-40 transition-opacity duration-300\">\n                 <div class=\"absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors duration-300\"></div>\n                 <div class=\"relative z-10 text-center p-4\">\n                   <div class=\"w-16 h-16 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center mx-auto mb-4 border border-white/50 group-hover:scale-110 transition-transform duration-300\">\n                     <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"white\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-1 text-white\"><polygon points=\"5 3 19 12 5 21 5 3\"/></svg>\n                   </div>\n                   <h3 class=\"text-white font-bold text-lg drop-shadow-md\">Video: Stemningen fra et elevforedrag</h3>\n                 </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n    <!-- Testimonials -->\n    <div class=\"max-w-7xl mx-auto px-4 py-16\">\n      <h3 className=\"text-2xl font-bold text-center mb-12\">Det siger skolerne</h3>\n      <div class=\"grid md:grid-cols-3 gap-8\">\n          <!-- Card 1 -->\n           <div class=\"bg-white p-6 rounded-2xl shadow-sm border border-gray-100\">\n             <!-- Icon: Quote -->\n             <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\" class=\"w-8 h-8 text-blue-200 mb-4\"><path d=\"M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H15.017C14.4647 8 14.017 8.44772 14.017 9V11C14.017 11.5523 13.5693 12 13.017 12H12.017V5H22.017V15C22.017 18.3137 19.3307 21 16.017 21H14.017ZM5.0166 21L5.0166 18C5.0166 16.8954 5.91203 16 7.0166 16H10.0166C10.5689 16 11.0166 15.5523 11.0166 15V9C11.0166 8.44772 10.5689 8 10.0166 8H6.0166C5.46432 8 5.0166 8.44772 5.0166 9V11C5.0166 11.5523 4.56889 12 4.0166 12H3.0166V5H13.0166V15C13.0166 18.3137 10.3303 21 7.0166 21H5.0166Z\"/></svg>\n             <p class=\"text-gray-600 mb-4 italic\">\"Eleverne var tryllebundet fra start til slut. Det var ikke en løftet pegefinger, men en invitation til at tænke selv.\"</p>\n             <div class=\"font-medium text-gray-900\">- Lærer, 8. årgang</div>\n           </div>\n           <!-- Card 2 -->\n           <div class=\"bg-white p-6 rounded-2xl shadow-sm border border-gray-100\">\n             <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\" class=\"w-8 h-8 text-blue-200 mb-4\"><path d=\"M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H15.017C14.4647 8 14.017 8.44772 14.017 9V11C14.017 11.5523 13.5693 12 13.017 12H12.017V5H22.017V15C22.017 18.3137 19.3307 21 16.017 21H14.017ZM5.0166 21L5.0166 18C5.0166 16.8954 5.91203 16 7.0166 16H10.0166C10.5689 16 11.0166 15.5523 11.0166 15V9C11.0166 8.44772 10.5689 8 10.0166 8H6.0166C5.46432 8 5.0166 8.44772 5.0166 9V11C5.0166 11.5523 4.56889 12 4.0166 12H3.0166V5H13.0166V15C13.0166 18.3137 10.3303 21 7.0166 21H5.0166Z\"/></svg>\n             <p class=\"text-gray-600 mb-4 italic\">\"Endelig noget om digital dannelse, som vi faktisk kunne bruge konkret i undervisningen ugen efter.\"</p>\n             <div class=\"font-medium text-gray-900\">- Skoleleder</div>\n           </div>\n           <!-- Card 3 -->\n           <div class=\"bg-white p-6 rounded-2xl shadow-sm border border-gray-100\">\n             <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\" class=\"w-8 h-8 text-blue-200 mb-4\"><path d=\"M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H15.017C14.4647 8 14.017 8.44772 14.017 9V11C14.017 11.5523 13.5693 12 13.017 12H12.017V5H22.017V15C22.017 18.3137 19.3307 21 16.017 21H14.017ZM5.0166 21L5.0166 18C5.0166 16.8954 5.91203 16 7.0166 16H10.0166C10.5689 16 11.0166 15.5523 11.0166 15V9C11.0166 8.44772 10.5689 8 10.0166 8H6.0166C5.46432 8 5.0166 8.44772 5.0166 9V11C5.0166 11.5523 4.56889 12 4.0166 12H3.0166V5H13.0166V15C13.0166 18.3137 10.3303 21 7.0166 21H5.0166Z\"/></svg>\n             <p class=\"text-gray-600 mb-4 italic\">\"Forældrene gik derfra med en helt ny forståelse for deres børns digitale liv.\"</p>\n             <div class=\"font-medium text-gray-900\">- Formand for skolebestyrelse</div>\n           </div>\n      </div>\n    </div>\n\n    <!-- Contact Form School -->\n    <div class=\"bg-gray-50 py-16\">\n      <div class=\"max-w-3xl mx-auto px-4\">\n        <!-- Reusing Form Structure -->\n        <div class=\"bg-white p-8 rounded-2xl shadow-lg border border-gray-100\">\n            <div class=\"flex items-center mb-6\">\n              <div class=\"w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center mr-4\">\n                <!-- Icon: Mail -->\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-blue-600\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"/><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"/></svg>\n              </div>\n              <h3 class=\"text-2xl font-bold text-gray-900\">Kontakt os for pris</h3>\n            </div>\n            \n            <form onsubmit=\"handleContactSubmit(event, 'school-subject-input')\" class=\"space-y-4\">\n              <div>\n                <label class=\"block text-sm font-medium text-gray-700 mb-1\">Din e-mail</label>\n                <input type=\"email\" required class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-shadow\" placeholder=\"navn@skole.dk\">\n              </div>\n              <div>\n                <label class=\"block text-sm font-medium text-gray-700 mb-1\">Emne</label>\n                <input id=\"school-subject-input\" type=\"text\" disabled class=\"w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg text-gray-500\" value=\"Forespørgsel: Indskoling\">\n              </div>\n              <div>\n                <label class=\"block text-sm font-medium text-gray-700 mb-1\">Besked (Valgfri)</label>\n                <textarea rows=\"4\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-shadow\" placeholder=\"Skriv eventuelt datoønsker eller særlige behov...\"></textarea>\n              </div>\n              <button type=\"submit\" class=\"w-full flex items-center justify-center px-8 py-3 bg-gray-900 text-white font-semibold rounded-lg hover:bg-black transition-colors\">\n                Send forespørgsel \n                <!-- Icon: Send -->\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-2\"><path d=\"m22 2-7 20-4-9-9-4Z\"/><path d=\"M22 2 11 13\"/></svg>\n              </button>\n            </form>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- VIEW: COMPANY -->\n  <div id=\"view-company\" class=\"view-section bg-slate-50 min-h-screen\">\n      <!-- Hero Section -->\n      <div class=\"bg-slate-900 text-white pt-20 pb-24 px-4 sm:px-6 lg:px-8\">\n        <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-12\">\n          <div class=\"md:w-1/2 space-y-8\">\n            <div class=\"inline-flex items-center px-3 py-1 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 text-sm font-medium\">\n              <!-- Icon: Briefcase Small -->\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"mr-2\"><rect width=\"20\" height=\"14\" x=\"2\" y=\"7\" rx=\"2\" ry=\"2\"/><path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"/></svg>\n              Corporate Workshop & Keynote\n            </div>\n            <h1 class=\"text-4xl md:text-5xl font-bold leading-tight\">\n              Køb et eksperiment, ikke bare et foredrag.\n            </h1>\n            <p class=\"text-xl text-slate-300 max-w-lg\">\n              Vi tilbyder en workshop-pakke, der ændrer virksomhedskulturen omkring digital tilgængelighed og fokus.\n            </p>\n            <div class=\"flex flex-wrap gap-4\">\n               <button onclick=\"document.getElementById('company-contact').scrollIntoView({ behavior: 'smooth' })\" class=\"px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg transition-colors\">\n                  Få et tilbud\n                </button>\n                <button onclick=\"shareLink()\" class=\"px-8 py-3 bg-transparent border border-slate-600 hover:bg-slate-800 text-white font-medium rounded-lg transition-colors flex items-center\">\n                  <!-- Icon: Share2 -->\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"mr-2\"><circle cx=\"18\" cy=\"5\" r=\"3\"/><circle cx=\"6\" cy=\"12\" r=\"3\"/><circle cx=\"18\" cy=\"19\" r=\"3\"/><line x1=\"8.59\" x2=\"15.42\" y1=\"13.51\" y2=\"17.49\"/><line x1=\"15.41\" x2=\"8.59\" y1=\"6.51\" y2=\"10.49\"/></svg>\n                  Del med chefen\n                </button>\n            </div>\n          </div>\n          <div class=\"md:w-1/2 w-full\">\n            <div class=\"rounded-xl overflow-hidden border border-slate-700 shadow-2xl relative h-64 md:h-80 bg-gray-900 group cursor-pointer\" onclick=\"alert('Video ville afspille her')\">\n                <img src=\"https://picsum.photos/800/603\" alt=\"Video thumbnail\" class=\"absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-40 transition-opacity duration-300\">\n                <div class=\"absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors duration-300\"></div>\n                <div class=\"absolute inset-0 flex flex-col items-center justify-center z-10 text-center p-4\">\n                  <div class=\"w-16 h-16 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center mx-auto mb-4 border border-white/50 group-hover:scale-110 transition-transform duration-300\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"white\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-1 text-white\"><polygon points=\"5 3 19 12 5 21 5 3\"/></svg>\n                  </div>\n                  <h3 class=\"text-white font-bold text-lg drop-shadow-md\">Hvad får virksomheden ud af det?</h3>\n                </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- The Package Breakdown -->\n      <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-16 relative z-10\">\n        <div class=\"bg-white rounded-2xl shadow-xl p-8 lg:p-12 border border-slate-200\">\n          <div class=\"text-center mb-12\">\n            <h2 class=\"text-3xl font-bold text-slate-900\">En komplet pakke</h2>\n            <p class=\"text-slate-500 mt-2\">Vi leverer tre konkrete elementer i forløbet</p>\n          </div>\n\n          <div class=\"grid md:grid-cols-3 gap-8\">\n            <!-- Step 1 -->\n            <div class=\"bg-slate-50 p-6 rounded-xl border border-slate-100 hover:border-indigo-200 transition-colors\">\n              <div class=\"w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center mb-4 text-indigo-600\">\n                <!-- Icon: Target -->\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><circle cx=\"12\" cy=\"12\" r=\"6\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/></svg>\n              </div>\n              <h3 class=\"text-xl font-bold text-slate-900 mb-2\">1. Sparring</h3>\n              <p class=\"text-slate-600\">\n                1 times online introducerende møde med ledelsen. Vi afdækker jeres behov og designer det eksperiment, I ønsker at lægge op til.\n              </p>\n            </div>\n\n            <!-- Step 2 -->\n            <div class=\"bg-slate-50 p-6 rounded-xl border border-slate-100 hover:border-indigo-200 transition-colors\">\n              <div class=\"w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center mb-4 text-indigo-600\">\n                <!-- Icon: Clock -->\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg>\n              </div>\n              <h3 class=\"text-xl font-bold text-slate-900 mb-2\">2. Workshop</h3>\n              <p class=\"text-slate-600\">\n                En engagerende, sjov og tankevækkende session for alle medarbejdere. Vi kombinerer viden med interaktive øvelser.\n              </p>\n            </div>\n\n            <!-- Step 3 -->\n            <div class=\"bg-slate-50 p-6 rounded-xl border border-slate-100 hover:border-indigo-200 transition-colors\">\n              <div class=\"w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center mb-4 text-indigo-600\">\n                <!-- Icon: Smartphone -->\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect width=\"14\" height=\"20\" x=\"5\" y=\"2\" rx=\"2\" ry=\"2\"/><path d=\"M12 18h.01\"/></svg>\n              </div>\n              <h3 class=\"text-xl font-bold text-slate-900 mb-2\">3. Værktøjer</h3>\n              <p class=\"text-slate-600\">\n                Lån af fysiske \"Dumbphone\" effekter i 10 dage: Smartphone låsesleeves og gammeldags vækkeure til alle deltagere.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Why Choose Us -->\n      <div class=\"py-20 max-w-4xl mx-auto px-4\">\n        <h2 class=\"text-3xl font-bold text-center text-slate-900 mb-12\">Hvorfor vælge dette format?</h2>\n        <div class=\"space-y-4\">\n            <div class=\"flex items-start\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-6 h-6 text-green-500 mr-4 flex-shrink-0 mt-0.5\"><path d=\"M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n              <span class=\"text-lg text-slate-700\">Det er mere end bare 'lyt og glem' - det er handling.</span>\n            </div>\n            <div class=\"flex items-start\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-6 h-6 text-green-500 mr-4 flex-shrink-0 mt-0.5\"><path d=\"M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n              <span class=\"text-lg text-slate-700\">Vi adresserer digital stress på en kollektiv måde.</span>\n            </div>\n            <div class=\"flex items-start\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-6 h-6 text-green-500 mr-4 flex-shrink-0 mt-0.5\"><path d=\"M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n              <span class=\"text-lg text-slate-700\">Det skaber en fælles referenceramme på kontoret.</span>\n            </div>\n            <div class=\"flex items-start\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-6 h-6 text-green-500 mr-4 flex-shrink-0 mt-0.5\"><path d=\"M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n              <span class=\"text-lg text-slate-700\">Professionelt setup, men med plads til humor.</span>\n            </div>\n        </div>\n      </div>\n\n      <!-- Contact -->\n      <div id=\"company-contact\" class=\"bg-white py-16 border-t border-slate-200\">\n        <div class=\"max-w-3xl mx-auto px-4\">\n            <!-- Reusing Form Structure -->\n            <div class=\"bg-white p-8 rounded-2xl shadow-lg border border-gray-100\">\n                <div class=\"flex items-center mb-6\">\n                  <div class=\"w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center mr-4\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-blue-600\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"/><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"/></svg>\n                  </div>\n                  <h3 class=\"text-2xl font-bold text-gray-900\">Kontakt os for pris</h3>\n                </div>\n                \n                <form onsubmit=\"handleContactSubmit(event, 'company-subject-input')\" class=\"space-y-4\">\n                  <div>\n                    <label class=\"block text-sm font-medium text-gray-700 mb-1\">Din e-mail</label>\n                    <input type=\"email\" required class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-shadow\" placeholder=\"navn@virksomhed.dk\">\n                  </div>\n                  <div>\n                    <label class=\"block text-sm font-medium text-gray-700 mb-1\">Emne</label>\n                    <input id=\"company-subject-input\" type=\"text\" disabled class=\"w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg text-gray-500\" value=\"Forespørgsel: Virksomhedsworkshop\">\n                  </div>\n                  <div>\n                    <label class=\"block text-sm font-medium text-gray-700 mb-1\">Besked (Valgfri)</label>\n                    <textarea rows=\"4\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-shadow\" placeholder=\"Skriv eventuelt datoønsker eller særlige behov...\"></textarea>\n                  </div>\n                  <button type=\"submit\" class=\"w-full flex items-center justify-center px-8 py-3 bg-gray-900 text-white font-semibold rounded-lg hover:bg-black transition-colors\">\n                    Send forespørgsel \n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ml-2\"><path d=\"m22 2-7 20-4-9-9-4Z\"/><path d=\"M22 2 11 13\"/></svg>\n                  </button>\n                </form>\n            </div>\n        </div>\n      </div>\n  </div>\n\n  <!-- Footer -->\n  <footer class=\"bg-gray-900 text-white py-12\">\n    <div class=\"max-w-7xl mx-auto px-4 text-center\">\n      <p class=\"text-gray-400\">© 2024 Eksperiment Ekspert. Alle rettigheder forbeholdes.</p>\n    </div>\n  </footer>\n\n</div>\n\n<!-- APPLICATION LOGIC -->\n<script>\n  // State variables (simulating React state)\n  let currentView = 'LANDING'; // 'LANDING', 'SCHOOL', 'COMPANY'\n  let currentSchoolGroup = 'INDSKOLING'; // 'INDSKOLING', 'UDSKOLING_UNGDOM'\n\n  // DOM Elements\n  const navHeader = document.getElementById('nav-header');\n  const navTitle = document.getElementById('nav-title');\n  const viewLanding = document.getElementById('view-landing');\n  const viewSchool = document.getElementById('view-school');\n  const viewCompany = document.getElementById('view-company');\n  const rootElement = document.getElementById('eksperiment-root');\n\n  // School Specific DOM\n  const btnIndskoling = document.getElementById('btn-indskoling');\n  const btnUdskoling = document.getElementById('btn-udskoling');\n  const contentIndskoling = document.getElementById('content-indskoling');\n  const contentUdskoling = document.getElementById('content-udskoling');\n  const schoolSubjectInput = document.getElementById('school-subject-input');\n\n  // Logic: Switch Views\n  function switchView(viewName) {\n    currentView = viewName;\n    \n    // Hide all views first\n    viewLanding.classList.remove('active');\n    viewSchool.classList.remove('active');\n    viewCompany.classList.remove('active');\n    \n    // Toggle Nav Header\n    if (viewName === 'LANDING') {\n      navHeader.classList.add('hidden');\n      rootElement.scrollIntoView({ behavior: 'smooth' });\n    } else {\n      navHeader.classList.remove('hidden');\n      window.scrollTo({ top: rootElement.offsetTop, behavior: 'smooth' });\n    }\n\n    // Show selected view\n    if (viewName === 'LANDING') {\n      viewLanding.classList.add('active');\n    } else if (viewName === 'SCHOOL') {\n      viewSchool.classList.add('active');\n      navTitle.textContent = 'Skoler & Uddannelser';\n    } else if (viewName === 'COMPANY') {\n      viewCompany.classList.add('active');\n      navTitle.textContent = 'Virksomheder';\n    }\n  }\n\n  // Logic: Switch School Grades\n  function setSchoolGrade(group) {\n    currentSchoolGroup = group;\n    \n    // Styling classes for Active/Inactive buttons\n    const activeClasses = ['bg-blue-600', 'text-white', 'shadow-lg', 'scale-105'];\n    const inactiveClasses = ['hover:bg-gray-100', 'text-gray-500'];\n\n    // Bubbles inside buttons (visual tweak)\n    const indskolingBubbles = btnIndskoling.querySelectorAll('.timeline-bubble');\n    const udskolingBubbles = btnUdskoling.querySelectorAll('.timeline-bubble');\n\n    if (group === 'INDSKOLING') {\n        // Activate Indskoling Button\n        btnIndskoling.classList.add(...activeClasses);\n        btnIndskoling.classList.remove(...inactiveClasses);\n        \n        // Deactivate Udskoling Button\n        btnUdskoling.classList.remove(...activeClasses);\n        btnUdskoling.classList.add(...inactiveClasses);\n\n        // Update Bubble Colors\n        indskolingBubbles.forEach(b => { b.classList.remove('bg-gray-200'); b.classList.add('bg-blue-500'); });\n        udskolingBubbles.forEach(b => { b.classList.remove('bg-blue-500'); b.classList.add('bg-gray-200'); });\n\n        // Switch Content\n        contentIndskoling.style.display = 'block';\n        contentUdskoling.style.display = 'none';\n\n        // Update Form Subject\n        if(schoolSubjectInput) schoolSubjectInput.value = \"Forespørgsel: Indskoling\";\n\n    } else {\n        // Activate Udskoling Button\n        btnUdskoling.classList.add(...activeClasses);\n        btnUdskoling.classList.remove(...inactiveClasses);\n        \n        // Deactivate Indskoling Button\n        btnIndskoling.classList.remove(...activeClasses);\n        btnIndskoling.classList.add(...inactiveClasses);\n\n        // Update Bubble Colors\n        udskolingBubbles.forEach(b => { b.classList.remove('bg-gray-200'); b.classList.add('bg-blue-500'); });\n        indskolingBubbles.forEach(b => { b.classList.remove('bg-blue-500'); b.classList.add('bg-gray-200'); });\n\n        // Switch Content\n        contentIndskoling.style.display = 'none';\n        contentUdskoling.style.display = 'block';\n\n        // Update Form Subject\n        if(schoolSubjectInput) schoolSubjectInput.value = \"Forespørgsel: Udskoling/Ungdom\";\n    }\n  }\n\n  // Logic: Share Link\n  async function shareLink() {\n    try {\n      await navigator.clipboard.writeText(window.location.href);\n      alert('Link kopieret til udklipsholderen!');\n    } catch (err) {\n      console.error('Failed to copy', err);\n      alert('Kunne ikke kopiere linket automatisk. Kopier venligst URLen fra browseren.');\n    }\n  }\n\n  // Logic: Form Submit\n  function handleContactSubmit(e, subjectInputId) {\n    e.preventDefault();\n    const subject = document.getElementById(subjectInputId).value;\n    alert(`Tak! Vi har modtaget din forespørgsel vedrørende \"${subject}\". Vi vender tilbage snarest.`);\n    e.target.reset();\n  }\n\n  // Initial Setup\n  // Ensure default state matches\n  setSchoolGrade('INDSKOLING');\n\n</script>",
