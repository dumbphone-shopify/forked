ter; justify-content: center; font-weight: bold; border: 2px solid var(--sk-leaf);\n  }\n  .sk-btn-card {\n    display: block; width: 100%; padding: 18px 0; background-color: var(--sk-clay); color: #fff; text-align: center;\n    border-radius: 8px; font-weight: bold; text-transform: uppercase; border: none; cursor: pointer; text-decoration: none;\n  }\n</style>\n\n<div class=\"sk-section\">\n  <div class=\"sk-container sk-offerings\">\n    <!-- Kort 1: Indskoling -->\n    <div class=\"sk-card sk-card-highlight\">\n      <div class=\"sk-badge-bounce\">GRATIS FOREDRAG</div>\n      <h2>Indskoling</h2>\n      <p style=\"text-transform: uppercase; font-size: 0.85rem; font-weight: 700; color: #888; margin-bottom: 10px;\">For Forældre</p>\n      <div class=\"sk-grades\">\n        <div class=\"sk-grade-bubble\">0.</div>\n        <div class=\"sk-grade-bubble\">1.</div>\n        <div class=\"sk-grade-bubble\">2.</div>\n        <div class=\"sk-grade-bubble\">3.</div>\n      </div>\n      <div class=\"sk-video-small\">[Video: Indskoling]</div>\n      <p class=\"sk-card-desc\">Et fælles sprog for forældre i de yngste klasser. Vi sætter rammerne for en god digital start.</p>\n      <a href=\"#kontakt\" class=\"sk-btn-card\">Bestil Gratis Foredrag</a>\n    </div>\n\n    <!-- Kort 2: Udskoling -->\n    <div class=\"sk-card\">\n      <h2>Udskoling & Ungdom</h2>\n      <p style=\"text-transform: uppercase; font-size: 0.85rem; font-weight: 700; color: #888; margin-bottom: 15px;\">For Eleverne</p>\n      <div class=\"sk-grades\">\n        <div class=\"sk-grade-bubble\" style=\"border-color: var(--sk-clay);\">4.</div>\n        <div class=\"sk-grade-bubble\" style=\"border-color: var(--sk-clay);\">-</div>\n        <div class=\"sk-grade-bubble\" style=\"border-color: var(--sk-clay);\">10.</div>\n        <div class=\"sk-grade-bubble\" style=\"border-color: var(--sk-clay); width: auto; padding: 0 10px; border-radius: 20px;\">Ungdom</div>\n      </div>\n      <div class=\"sk-video-small\">[Video: Elever]</div>\n      <p class=\"sk-card-desc\">Vi taler ikke ned til de unge. Vi taler med dem. Om algoritmer og fællesskaber.</p>\n      <a href=\"#kontakt\" class=\"sk-btn-card\" style=\"background-color: var(--sk-text);\">Få et tilbud</a>\n    </div>\n  </div>\n</div>\n\n\n<style>\n  :root {\n    --sk-sand: #FDFBF7;\n    --sk-text: #3E2103;   /* Den brune tekstfarve */\n    --sk-clay: #BC7859;\n    --sk-white: #FFFFFF;\n    --sk-leaf: #5E8C61;\n    --sk-head: var(--font-heading-family), 'Playfair Display', serif;\n    --sk-body: var(--font-body-family), sans-serif;\n  }\n  .sk-section {\n    width: 100%; padding: 60px 20px;\n    background-color: var(--sk-sand); color: var(--sk-text);\n    font-family: var(--sk-body); box-sizing: border-box;\n  }\n  .sk-section * { box-sizing: border-box; }\n  .sk-container { max-width: 1200px; margin: 0 auto; }\n</style>\n\n<style>\n  .sk-testimonials { text-align: center; background-color: var(--sk-text); color: var(--sk-white); }\n  .sk-quote { font-family: var(--sk-head); font-size: 1.5rem; font-style: italic; max-width: 800px; margin: 0 auto 20px auto; }\n  .sk-author { text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.9rem; opacity: 0.8; }\n</style>\n\n<div class=\"sk-section sk-testimonials\">\n  <div class=\"sk-container\">\n    <div class=\"sk-quote\">\"Det bedste foredrag vi har haft i årevis. Eleverne lagde faktisk telefonerne væk i pausen.\"</div>\n    <div class=\"sk-author\">— Lærer, Østerbro Skole</div>\n    <br><br>\n    <div class=\"sk-quote\">\"Jeg troede det ville være kedeligt, men det var sygt spændende.\"</div>\n    <div class=\"sk-author\">— Elev, 8. klasse</div>\n  </div>\n</div>\n\n\n<style>\n  :root {\n    --sk-sand: #FDFBF7;\n    --sk-text: #3E2103;   /* Den brune tekstfarve */\n    --sk-clay: #BC7859;\n    --sk-white: #FFFFFF;\n    --sk-leaf: #5E8C61;\n    --sk-head: var(--font-heading-family), 'Playfair Display', serif;\n    --sk-body: var(--font-body-family), sans-serif;\n  }\n  .sk-section {\n    width: 100%; padding: 60px 20px;\n    background-color: var(--sk-sand); color: var(--sk-text);\n    font-family: var(--sk-body); box-sizing: border-box;\n  }\n  .sk-section * { box-sizing: border-box; }\n  .sk-container { max-width: 1200px; margin: 0 auto; }\n</style>\n\n<style>\n  .sk-contact-wrap { text-align: center; max-width: 600px; margin: 0 auto; }\n  .sk-form-group { margin-bottom: 20px; text-align: left; }\n  .sk-label { display: block; margin-bottom: 8px; font-weight: 600; font-size: 0.9rem; color: var(--sk-text); }\n  .sk-input { width: 100%; padding: 15px; border: 1px solid #ddd; border-radius: 8px; font-family: var(--sk-body); font-size: 1rem; background-color: var(--sk-white); color: var(--sk-text); }\n  .sk-submit { background-color: var(--sk-clay); color: #fff; border: none; padding: 18px 40px; font-size: 1rem; font-weight: bold; text-transform: uppercase; border-radius: 8px; cursor: pointer; width: 100%; }\n  .sk-submit:hover { background-color: #a86548; }\n</style>\n\n<div class=\"sk-section\" id=\"kontakt\">\n  <div class=\"sk-container sk-contact-wrap\">\n    <h2 style=\"font-family: var(--sk-head); font-size: 2.5rem; margin-bottom: 30px; color: var(--sk-text);\">Vil I høre mere?</h2>\n    <p style=\"margin-bottom: 30px;\">Udfyld formularen, så vender vi tilbage.</p>\n    \n    <form action=\"/contact\" method=\"post\">\n      <div class=\"sk-form-group\">\n        <label class=\"sk-label\">Navn på Skole</label>\n        <input type=\"text\" class=\"sk-input\" placeholder=\"Fx. Viborg Katedralskole\">\n      </div>\n      <div class=\"sk-form-group\">\n        <label class=\"sk-label\">Kontaktperson</label>\n        <input type=\"text\" class=\"sk-input\" placeholder=\"Dit navn\">\n      </div>\n      <div class=\"sk-form-group\">\n        <label class=\"sk-label\">Email</label>\n        <input type=\"email\" class=\"sk-input\" placeholder=\"din@email.dk\">\n      </div>\n      <button type=\"submit\" class=\"sk-submit\">Send For