        "custom_liquid": "<style>\n  :root {\n    --sk-sand: #FDFBF7;\n    --sk-text: #3E2103;   /* Den brune tekstfarve */\n    --sk-clay: #BC7859;\n    --sk-white: #FFFFFF;\n    --sk-leaf: #5E8C61;\n    --sk-head: var(--font-heading-family), 'Playfair Display', serif;\n    --sk-body: var(--font-body-family), sans-serif;\n  }\n  .sk-section {\n    width: 100%; padding: 60px 20px;\n    background-color: var(--sk-sand); color: var(--sk-text);\n    font-family: var(--sk-body); box-sizing: border-box;\n  }\n  .sk-section * { box-sizing: border-box; }\n  .sk-container { max-width: 1200px; margin: 0 auto; }\n</style>\n\n<style>\n  .sk-offerings { display: flex; gap: 30px; flex-wrap: wrap; align-items: stretch; }\n  .sk-card {\n    flex: 1; min-width: 320px; background: var(--sk-white); padding: 40px;\n    border-radius: 16px; box-shadow: 0 10px 30px rgba(62, 33, 3, 0.05);\n    position: relative; border: 1px solid rgba(62, 33, 3, 0.05);\n    transition: transform 0.3s ease;\n    /* Flex column sikrer at indholdet strækkes og knappen kan skubbes i bunden */\n    display: flex; flex-direction: column; \n    height: 100%;\n  }\n  .sk-card:hover { transform: translateY(-5px); }\n  .sk-card h2 { \n    font-family: var(--sk-head); \n    font-size: 1.8rem; \n    margin-bottom: 15px; \n    color: var(--sk-text); \n  }\n  \n  /* Dette sikrer at knappen skubbes helt ned i bunden, så de flugter */\n  .sk-card-desc { \n    margin-bottom: 30px; line-height: 1.6; color: var(--sk-text); opacity: 0.8;\n    flex-grow: 1; /* Fylder restpladsen ud */\n  }\n  \n  /* Billede styling */\n  .sk-card-img {\n    width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover;\n    border-radius: 8px; margin-bottom: 30px; display: block;\n    box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n  }\n\n  .sk-card-highlight { border: 2px solid var(--sk-leaf); }\n  .sk-badge-bounce {\n    position: absolute; top: -20px; right: 20px; background-color: var(--sk-leaf); color: white;\n    padding: 8px 16px; border-radius: 50px; font-weight: 700; text-transform: uppercase; font-size: 0.8rem;\n    letter-spacing: 0.05em; animation: sk-bounce 2s infinite; box-shadow: 0 5px 15px rgba(94, 140, 97, 0.4);\n  }\n  @keyframes sk-bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }\n  \n  /* Grades layout */\n  .sk-grades { \n    display: flex; gap: 10px; margin-bottom: 25px; flex-wrap: wrap; \n    /* Vi sætter en min-height her, så billedet nedenunder starter samme sted på begge kort, \n       selvom der er flere bobler i den ene end den anden */\n    min-height: 90px; align-content: flex-start;\n  }\n  .sk-grade-bubble {\n    min-width: 40px; height: 40px; border-radius: 50%; background-color: var(--sk-sand); color: var(--sk-text);\n    display: flex; align-items: center; justify-content: center; font-weight: bold; border: 2px solid var(--sk-leaf);\n    box-sizing: border-box;\n  }\n  \n  .sk-btn-card {\n    display: block; width: 100%; padding: 18px 0; background-color: var(--sk-clay); color: #fff; text-align: center;\n    border-radius: 8px; font-weight: bold; text-transform: uppercase; border: none; cursor: pointer; text-decoration: none;\n    margin-top: auto; /* Sikkerhedsnet */\n  }\n  \n  @media(max-width: 768px) {\n    .sk-grades { min-height: auto; } /* På mobil behøver vi ikke matche højden */\n  }\n</style>\n\n<div class=\"sk-section\">\n  <div class=\"sk-container sk-offerings\">\n    <!-- Kort 1: Indskoling -->\n    <div class=\"sk-card sk-card-highlight\">\n      <div class=\"sk-badge-bounce\">GRATIS FOREDRAG</div>\n      <h2>Indskoling</h2>\n      <p style=\"text-transform: uppercase; font-size: 0.85rem; font-weight: 700; color: #888; margin-bottom: 10px;\">For Forældre</p>\n      <div class=\"sk-grades\">\n        <div class=\"sk-grade-bubble\">0.</div>\n        <div class=\"sk-grade-bubble\">1.</div>\n        <div class=\"sk-grade-bubble\">2.</div>\n        <div class=\"sk-grade-bubble\">3.</div>\n      </div>\n      \n      <img src=\"https://images.unsplash.com/photo-1503676260728-1c00da094a0b?ixlib=rb-1.2.1&auto=format&fit=crop&w=1000&q=80\" alt=\"Børn i skole\" class=\"sk-card-img\" />\n      \n      <p class=\"sk-card-desc\">\n        Vi kommer ud og taler med jer forældre om, hvordan man effektivt udskyder smartphonen. Der er plads til kritiske spørgsmål i dette løsningsorienterede foredrag, som kan tilbydes alle forældre i indskolingen.\n      </p>\n      <a href=\"https://dumbphone.dk/pages/indskolingsforedrag\" class=\"sk-btn-card\">Se mere om det gratis foredrag</a>\n    </div>\n\n    <!-- Kort 2: Udskoling -->\n    <div class=\"sk-card\">\n      <h2>Udskoling & Ungdom</h2>\n      <p style=\"text-transform: uppercase; font-size: 0.85rem; font-weight: 700; color: #888; margin-bottom: 15px;\">For Eleverne</p>\n      <div class=\"sk-grades\">\n        <!-- Samlet 4-10 -->\n        <div class=\"sk-grade-bubble\" style=\"border-color: var(--sk-clay); width: auto; padding: 0 12px; border-radius: 20px;\">4. - 10. klasse</div>\n        <!-- Efterskole / Højskole / Gymnasie -->\n        <div class=\"sk-grade-bubble\" style=\"border-color: var(--sk-clay); width: auto; padding: 0 12px; border-radius: 20px;\">Efterskole</div>\n        <div class=\"sk-grade-bubble\" style=\"border-color: var(--sk-clay); width: auto; padding: 0 12px; border-radius: 20px;\">Højskole</div>\n        <div class=\"sk-grade-bubble\" style=\"border-color: var(--sk-clay); width: auto; padding: 0 12px; border-radius: 20px;\">Gymnasie</div>\n        <!-- OSV -->\n        <div class=\"sk-grade-bubble\" style=\"border-color: var(--sk-clay); width: auto; padding: 0 12px; border-radius: 20px;\">OSV.</div>\n      </div>\n      \n      <img src=\"https://images.unsplash.com/photo-1511632765486-a01980e01a18?ixlib=rb-1.2.1&auto=format&fit=crop&w=1000&q=80\" alt=\"Unge på efterskole hygger\" class=\"sk-card-img\" />\n\n      <p class=\"sk-card-desc\">\n        Bygget på 2.500 elevers erfaringer med 10 dages smartphonefrihed. Vi møder de unge i øjenhøjde. Det er mere end et foredrag – vi lægger op til små eksperimenter i ugerne efter.\n      </p>\n      <a href=\"https://dumbphone.dk/pages/se-mere\" class=\"sk-btn-card\" style=\"background-color: var(--sk-text);\">Se mere om dette foredrag</a>\n    </div>\n  </div>\n</div>",
